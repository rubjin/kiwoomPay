# 의존성 · 빌드 결과
node_modules
dist
storybook-static
*.tsbuildinfo
coverage

# 도구 캐시 · 로그
.cache
.eslintcache
.stylelintcache
*.log
vite.config.*.timestamp-*

# pnpm만 사용 — 다른 패키지 관리자의 lockfile은 올리지 않는다
package-lock.json
yarn.lock

# 로컬 환경 변수 (비밀 값)
.env
.env.*
!.env.example

# 백업 · 임시 파일
*_bak.*
*.bak
*.orig
*.tmp
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# 에디터 — VS Code는 팀 공용 설정만 올린다
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code 개인 설정 (팀 공용 .claude/commands는 올린다)
.claude/settings.local.json

# 상용 라이브러리 (IBSheet8 — 라이선스 · 상용 제품이라 공개 저장소에 올리지 않는다, vendor/README.md)
vendor/ibsheet/
vendor/ibsheet-docs/

# 개발 중 생기는 로컬 파일
*.local
.vite
.turbo
.pnpm-store
.temp
.tmp
.history
*.swo
ehthumbs.db
$RECYCLE.BIN/

# 복사본 (예: "README copy.md", "README - 복사본.md")
* copy.*
* - 복사본*
