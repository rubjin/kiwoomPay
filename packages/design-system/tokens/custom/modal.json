      },
      "Padding": {
        "$type": "dimension",
        "$value": "{space.12}"
      },
      "RowGap": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "LabelWidth": {
        "$type": "dimension",
        "$value": "104px",
        "$description": "측정값: 값이 상자 왼쪽 128에서 시작"
      },
      "LabelGap": {
        "$type": "dimension",
        "$value": "{space.12}"
      },
      "Label": {
        "$type": "color",
        "$value": "{Text.Secondary}"
      },
      "Value": {
        "$type": "color",
        "$value": "{Text.Body}"
      }
