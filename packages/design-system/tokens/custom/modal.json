{
  "Modal": {
    "Width": {
      "SM": {
        "$type": "dimension",
        "$value": "400px",
        "$description": "size sm: Alert · Confirm (Modal 패턴 측정)"
      },
      "MD": {
        "$type": "dimension",
        "$value": "620px",
        "$description": "size md: Information (Modal 패턴 측정)"
      },
      "LG": {
        "$type": "dimension",
        "$value": "800px",
        "$description": "size lg: Form (Modal 패턴 측정)"
      }
    },
    "Padding": {
      "$type": "dimension",
      "$value": "{space.20}",
      "$description": "측정값"
    },
    "Radius": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "측정값(모서리 윤곽)"
    },
    "SectionGap": {
      "$type": "dimension",
      "$value": "{space.20}",
      "$description": "Header ↔ Body ↔ Footer"
