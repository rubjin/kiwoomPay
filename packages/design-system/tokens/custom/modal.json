    "MessageGap": {
      "$type": "dimension",
      "$value": "{space.20}",
      "$description": "설명만 있는 본문(Alert·Confirm)의 추가 아래 여백 → Footer까지 40"
    },
    "FooterGap": {
      "$type": "dimension",
      "$value": "{space.8}",
      "$description": "버튼 간격"
    },
    "ViewportMargin": {
      "$type": "dimension",
      "$value": "{space.40}",
      "$description": "최소 안전 여백 상·하·좌·우 40 → max-height calc(100vh - 80px)"
    },
    "CloseSize": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Header Close(X)"
    },
    "Shadow": {
      "$type": "shadow",
      "$value": "0 4px 20px rgba(0, 0, 0, 0.1)",
      "$description": "TODO(시안) 그림자 근사값"
    },
    "Bg": {
      "$type": "color",
      "$value": "{Bg.Surface}"
    },
    "Border": {
      "$type": "color",
      "$value": "{Line.Subtle}"
    },
    "Title": {
      "$type": "color",
      "$value": "{Text.Body}"
    },
    "Description": {
      "$type": "color",
      "$value": "{Text.Secondary}"
    },
    "Close": {
      "$type": "color",
      "$value": "{Text.Secondary}"
