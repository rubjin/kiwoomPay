{
  "Auth": {
    "Bg": {
      "$type": "color",
      "$value": "{Bg.Surface}",
      "$description": "로그인 화면 배경 (Figma Base/White)"
    },
    "HeaderBorder": { "$type": "color", "$value": "{Line.Subtle}" },
    "Title": { "$type": "color", "$value": "{Text.Heading}" },
    "Label": { "$type": "color", "$value": "{Text.Label}" },
    "Text": { "$type": "color", "$value": "{Text.Body}" },
    "Placeholder": { "$type": "color", "$value": "{Text.Placeholder}" },
    "Underline": { "$type": "color", "$value": "{Line.Subtle}" },
    "UnderlineFocus": {
      "$type": "color",
      "$value": "{Primary.500}",
      "$description": "TODO(시안) 입력 중 밑줄 — Figma에는 빈 상태만 있어 필드 포커스 색으로"
    },
    "UnderlineError": { "$type": "color", "$value": "{Status.Error.Border}" },
    "ErrorText": { "$type": "color", "$value": "{Status.Error.Text}" },
    "Icon": {
      "$type": "color",
      "$value": "{Text.Placeholder}",
      "$description": "비밀번호 보기 아이콘 (Neutral 500)"
    },
    "NoticeBg": { "$type": "color", "$value": "{Primary.50}" },
    "NoticeText": { "$type": "color", "$value": "{Text.Secondary}" },
    "InfoBg": {
      "$type": "color",
      "$value": "{Neutral.50}",
      "$description": "SMS 인증 등록된 휴대전화번호 상자 (시안 #F8FAFC)"
    },
    "Timer": {
      "$type": "color",
      "$value": "{Status.Error.Border}",
      "$description": "인증 남은 시간 (Header 세션 시간과 같은 색)"
    }
  }
}
