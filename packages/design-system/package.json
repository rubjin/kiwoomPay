{
  "name": "@kiwoompay/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/kiwoompay-ui.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "dev": "pnpm storybook",
    "storybook": "pnpm tokens && pnpm icons && storybook dev -p 6006",
    "build-storybook": "pnpm tokens && pnpm icons && storybook build",
    "build": "pnpm tokens && pnpm icons && vite build && tsc -p tsconfig.build.json && node scripts/copy-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:script && pnpm lint:style",
    "lint:script": "eslint .",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "icons": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pretendard": "^1.3.9",
    "prettier": "3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "4.0.1",
    "sass": "^1.108.1",
    "storybook": "^10.6.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  }
}
