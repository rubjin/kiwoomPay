{
  "name": "kiwoompay-ui",
  "private": true,
  "description": "키움페이 백오피스 3종(가맹점관리자 / 내부관리자 / 영업대행사) 공용 디자인 시스템",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "pnpm --filter @kiwoompay/design-system tokens",
    "storybook": "pnpm --filter @kiwoompay/design-system storybook",
    "build": "pnpm --filter @kiwoompay/design-system build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "screens": "pnpm --filter @kiwoompay/screen-list dev"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
